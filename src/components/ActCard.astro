---
import { useT } from '../i18n/t.js';
import { artOf, GO_ICON } from '../data/activities.js';
const { id, done = false } = Astro.props;
const { t, home } = useT(Astro);
---
<a class="tcard" href={home + 'activities/' + id + '/'}><Fragment set:html={artOf(id, t)} /><span class="go" aria-hidden="true"><Fragment set:html={GO_ICON} /></span><span class="meta"><h3 set:html={t('acts.names.' + id)} /><p set:html={t('acts.cards.' + id)} />{done && <span class="tdone" data-done={id} hidden>{t('acts.done')}</span>}</span></a>
