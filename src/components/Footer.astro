---
import { base } from '../base.js';
import { useT, twinPath } from '../i18n/t.js';
const { t, lang, home } = useT(Astro);
---
<footer class="site">
  <div class="wrap"><div class="inner">
    <div>
      <a class="brand foot-brand" href={home}><span class="sr-only">{t('site.homeLabel')}</span><svg class="badge" viewBox="0 0 220 220" aria-hidden="true"><defs><path id="bTop" d="M30 110a80 80 0 0 1 160 0"/><path id="bBot" d="M24 110a86 86 0 0 0 172 0"/></defs><circle cx="110" cy="110" r="106" fill="var(--sage)"/><circle cx="110" cy="110" r="64" fill="#fff"/><text font-family="Geist, system-ui, sans-serif" font-size="17" font-weight="600" letter-spacing="5" fill="#16211C"><textPath href="#bTop" startOffset="50%" text-anchor="middle">OWN TWO FEET</textPath></text><text font-family="Geist, system-ui, sans-serif" font-size="13" font-weight="500" letter-spacing="4" fill="#46504A"><textPath href="#bBot" startOffset="50%" text-anchor="middle">LIFE SKILLS · HANDS ON</textPath></text><circle cx="40" cy="110" r="3" fill="var(--accent)"/><circle cx="180" cy="110" r="3" fill="var(--accent)"/><g transform="translate(70 64) scale(.82)"><g transform="translate(40 20) scale(-1 1)"><circle cx="24" cy="7" r="6" fill="#16211C"/><circle cx="33" cy="11.5" r="4" fill="#16211C"/><circle cx="38.5" cy="18" r="3.3" fill="#16211C"/><circle cx="41" cy="25" r="2.8" fill="#16211C"/><path d="M21 2C33 3 38 15 37 30C36 43 31 51 30 61C29 71 32 79 30 89C28 98 13 98 11 89C9 79 13 71 11 61C9 50 3 41 4 28C5 13 10 1 21 2Z" transform="translate(1 18) scale(.86)" fill="#16211C"/></g><g transform="translate(52 0)"><circle cx="24" cy="7" r="6" fill="var(--accent)"/><circle cx="33" cy="11.5" r="4" fill="var(--accent)"/><circle cx="38.5" cy="18" r="3.3" fill="var(--accent)"/><circle cx="41" cy="25" r="2.8" fill="var(--accent)"/><path d="M21 2C33 3 38 15 37 30C36 43 31 51 30 61C29 71 32 79 30 89C28 98 13 98 11 89C9 79 13 71 11 61C9 50 3 41 4 28C5 13 10 1 21 2Z" transform="translate(1 18) scale(.86)" fill="var(--accent)"/></g></g></svg></a>
      <p class="tag">{t('site.tag')}</p>
    </div>
    <div><h3>{t('footer.explore')}</h3><ul><li><a href={home + 'workshops/'}>{t('nav.workshops')}</a></li><li><a href={home + 'activities/'}>{t('nav.activities')}</a></li><li><a href={home + 'story/'}>{t('nav.story')}</a></li><li><a href={home + 'get-involved/'}>{t('nav.involved')}</a></li></ul></div>
    <div><h3>{t('footer.start')}</h3><ul><li><a href={home + '#interest'}>{t('footer.interest')}</a></li><li><a href={home + 'activities/tools/'}>{t('footer.tools')}</a></li><li><a href={home + 'activities/budget/'}>{t('footer.budget')}</a></li><li><a href={home + 'manuals/'}>{t('nav.manuals')}</a></li><li><a href={twinPath(Astro.url.pathname)} lang={lang === 'es' ? 'en' : 'es-MX'} hreflang={lang === 'es' ? 'en' : 'es'} data-setlang={lang === 'es' ? 'en' : 'es'}>{t('lang.other')}</a></li><li><a href={home + '#faq'}>{t('footer.faq')}</a></li><li><a href={home + 'privacy.html'}>{t('site.privacy')}</a></li></ul></div>
    <div class="fine"><span>{t('site.copy')}</span><a href="mailto:hello.owntwofeet@gmail.com">hello.owntwofeet@gmail.com</a><a href={home + 'privacy.html'}>{t('site.privacy')}</a></div>
  </div></div>
</footer>
