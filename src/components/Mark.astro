---
// The round badge on the sub pages. id: unique per page, for the curved text paths.
// small: the plainer badge with two feet (manuals list, privacy, 404); otherwise the one with toes (each manual).
const { id, small = false } = Astro.props;
const T = id + 'T', B = id + 'B';
---
