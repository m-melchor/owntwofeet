---
import { useT } from '../../i18n/t.js';
import JsText from '../JsText.astro';
const { t } = useT(Astro);
const ids = ['tshirt', 'jeans', 'bath', 'jersey', 'socks', 'hoodie', 'hand', 'sweats'];
const bks = ['dark', 'light', 'towel'];
const bkAria = (k) => t('actLaundry.bkAria').replace('{b}', t('actLaundry.lbs.' + k)).replace('{t}', t('actLaundry.empty').toLowerCase());
---
    <JsText name="actLaundry" />
    <article class="activity" id="laundry" aria-labelledby="laundry-h">
      <slot name="top" />
      <div class="act-head">
        <div class="t"><h2 id="laundry-h"><Fragment set:html={t('actLaundry.h2')} /> <span class="tdone done-chip" data-done="laundry" hidden>{t('acts.done')}</span></h2><p>{t('actLaundry.intro')}</p></div>
        <div class="act-tools"><button class="reset" type="button" id="launReset"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>{t('acts.reset')}</button></div>
      </div>
      <div class="act-body scam">
        <div class="lstage" id="lStage"><div class="pile" id="lPile" role="group" aria-label={t('actLaundry.pileAria')}>{ids.map((id) => <div class="cell"><button class="piece" type="button" data-i={id} aria-pressed="false"><svg viewBox="0 0 120 120" aria-hidden="true"><use href={'#l-' + id}></use></svg><span>{t('actLaundry.names.' + id)}</span></button></div>)}</div><div class="lfb"><div class="fb" id="lFb" aria-live="polite"></div></div><div class="baskets" id="lBaskets" role="group" aria-label={t('actLaundry.basketsAria')}>{bks.map((k) => <button class="bk" type="button" data-b={k} aria-label={bkAria(k)}><svg viewBox="0 0 140 110" aria-hidden="true"><use href={'#l-bk-' + k}></use></svg><b>{t('actLaundry.lb.' + k)}</b><small>{t('actLaundry.empty')}</small></button>)}</div></div>
        <div class="side-card" id="lSide"><div style="display:flex;justify-content:space-between;gap:10px;align-items:center"><span class="label">{t('actLaundry.part1')}</span><div class="prog" id="lProg" aria-hidden="true"><i class=""></i><i class=""></i><i class=""></i><i class=""></i><i class=""></i><i class=""></i><i class=""></i><i class=""></i></div></div><h3>{t('actLaundry.sortH')}</h3><p>{t('actLaundry.dragStatic')}</p><div class="push"><button class="btn btn-ink" id="lGo" type="button" hidden="">{t('actLaundry.readLabels')}</button></div></div>
      </div>
      <div class="practiced" id="pracLaundry" role="region" aria-label={t('acts.practiced')} hidden></div>
      <slot name="end" />
    </article>
