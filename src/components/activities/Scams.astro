---
import { useT } from '../../i18n/t.js';
import JsText from '../JsText.astro';
const { t } = useT(Astro);
const first = t('actScams.ms.0.b').replace(/[\[\]]/g, '');
---
    <JsText name="actScams" />
    <article class="activity" id="scams" aria-labelledby="scam-h">
      <slot name="top" />
      <div class="act-head">
        <div class="t"><h2 id="scam-h">{t('acts.names.scams')} <span class="tdone done-chip" data-done="scams" hidden>{t('acts.done')}</span></h2><p>{t('actScams.intro')}</p></div>
        <div class="act-tools"><div class="prog" id="scamProg" aria-hidden="true"><i class="cur"></i><i class=""></i><i class=""></i><i class=""></i><i class=""></i><i class=""></i></div><button class="reset" type="button" id="scamReset"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>{t('acts.reset')}</button></div>
      </div>
      <div class="act-body scam">
        <div class="phone-wrap">
          <div class="phone" id="scamPhone" aria-label={t('actScams.phoneLabel')}>
            <div class="bar" aria-hidden="true"><span>9:41</span><span id="scamCount">1 / 6</span></div>
            <div class="from"><span class="av" id="scamAv" aria-hidden="true">?</span><div style="min-width:0"><b id="scamFrom">{t('actScams.ms.0.f')}</b><small id="scamChan">{t('actScams.ms.0.c')}</small></div></div>
            <div class="bw"><p class="bubble" id="scamBody">{first}</p><span class="stamp" id="scamStamp" aria-hidden="true" hidden></span></div>
            <div class="after" id="scamAfter"></div>
          </div>
        </div>
        <div class="side-card">
          <span class="label">{t('actScams.yourCall')}</span>
          <h3>{t('actScams.question')}</h3>
          <div class="duo"><button class="btn btn-line" id="scamSafe" type="button">{t('actScams.looksSafe')}</button><button class="btn btn-line" id="scamBad" type="button">{t('actScams.itsScam')}</button></div>
          <div class="fb" id="scamFb" aria-live="polite"></div>
          <div class="push"><button class="btn btn-line" id="scamShow" type="button" hidden>{t('actScams.showMissed')}</button><button class="btn btn-ink" id="scamNext" type="button" hidden>{t('actScams.nextMsg')}</button></div>
        </div>
      </div>
      <div class="practiced" id="pracScams" role="region" aria-label={t('acts.practiced')} hidden></div>
      <slot name="end" />
    </article>
