---
import { base } from '../../base.js';
import { useT } from '../../i18n/t.js';
const { t, lang, home } = useT(Astro);
import ActCard from '../ActCard.astro';
import JsText from '../JsText.astro';
const PV = t('actpv.items');
const PVI = [0, 2, 3, 4];
---
<!-- ================= ACTIVITIES ================= -->
<div class="view" data-view="activities" id="activities">
  <section class="phead ctr"><div class="wrap"><div class="panel butter with-art">
    <svg class="phead-art" viewBox="0 0 320 300" aria-hidden="true"><g transform="translate(36 22) rotate(-14 45 135)"><use href="#t-hammer" width="90" height="270"/></g><g transform="translate(124 6)"><use href="#t-level" width="80" height="285"/></g><g transform="translate(206 22) rotate(12 40 130)"><use href="#t-wrench" width="80" height="260"/></g></svg>
    <h1 class="h-xl" tabindex="-1" data-focus>{t('actpage.h1')}</h1>
    <p class="lede" style="color:#46504A">{t('actpage.lede')}</p>
  </div></div></section>

  <section id="actPicker"><div class="wrap">
    <div class="stg teaser pick" id="pickGrid">
      <ActCard id="tools" done />
      <ActCard id="budget" done />
      <ActCard id="scams" done />
      <ActCard id="call" done />
      <ActCard id="laundry" done />
    </div>
    <details class="more" id="previews" open>
      <summary id="prev-h">{t('actpv.more').replace('{n}', PV.length)}</summary>
      <div class="more-in"><p>{t('actpage.planned')}</p>
      <div class="stg previews" id="previewGrid">{PV.map((p, k) => <article class="pv" style={`--i: ${PVI[k]};`}><div class="top"><span class="chip soon">{p.s}</span></div><h3>{p.t}</h3><p>{p.d}</p><details><summary>{t('actpv.practice')}</summary><ul>{p.b.map((x) => <li>{x}</li>)}</ul></details></article>)}</div></div>
    </details>
  </div></section>
  <section class="act-cta"><div class="wrap"><div class="panel sage" style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center"><div style="display:grid;gap:12px;max-width:560px"><h2 class="h-md">{t('actpage.ctaH')}</h2><p class="muted">{t('actpage.ctaP')}</p></div><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-ink" href={home + '#interest'}>{t('actpage.join')}</a><a class="btn btn-line" href={home + 'workshops/'}>{t('actpage.workshops')}</a></div></div></div></section>
<JsText name="actpv" />
</div>
