---
import { base } from '../../base.js';
import ActCard from '../ActCard.astro';
import InterestForm from '../InterestForm.astro';
// The eight topic tiles. Their lessons live in public/js/home.js (MODS) and open below the tiles on a tap.
const TOPICS = [
  { k: 'home', t: 'Home & tools', ic: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>' },
  { k: 'tech', t: 'Tech & online safety', ic: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M11 18.5h2"/>' },
  { k: 'care', t: 'Personal care', ic: '<path d="M8 3l-5 3 2 4 2-1v12h10V9l2 1 2-4-5-3c-.5 1.7-2 3-4 3s-3.5-1.3-4-3z"/>' },
  { k: 'cook', t: 'Simple cooking', ic: '<path d="M3 11h14v3a6 6 0 0 1-6 6H9a6 6 0 0 1-6-6zM17 12h4M7 7c0-1.5 1-1.5 1-3M11 7c0-1.5 1-1.5 1-3"/>' },
  { k: 'money', t: 'Money', ic: '<rect x="2.5" y="6" width="19" height="13" rx="2.5"/><path d="M16 12.5h2.5M2.5 10h19"/>' },
  { k: 'comm', t: 'Communication', ic: '<path d="M4 5h16v10H9l-5 4z"/>' },
  { k: 'help', t: 'Knowing when to ask', ic: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.3 2.4c-.5.2-.8.6-.8 1.1v.5M12 16.5v.5"/>' },
  { k: 'car', t: 'Vehicle basics', later: true, ic: '<path d="M4 16V12l2-5h12l2 5v4M4 16h16M4 16v3M20 16v3"/><circle cx="7.5" cy="13.5" r=".9"/><circle cx="16.5" cy="13.5" r=".9"/>' }
];
---
<!-- ================= HOME ================= -->
<div class="view" data-view="home" id="home">

  <section class="hero">
    <div class="wrap">
      <div class="hero-card">
        <div class="hero-copy">
          <h1 class="h-xl" tabindex="-1" data-focus>Skills for life, taught <em>side by side.</em></h1>
          <p class="lede" style="color:#46504A">Hands-on workshops for schools and community groups. Boys and young men learn everyday skills by actually doing them, with a mentor right there to help.</p>
          <div class="acts">
            <a class="btn btn-ink" href={base + '#interest'}>Join the Interest List</a>
            <a class="btn btn-line" href={base + 'activities/'}>Explore Activities</a>
          </div>
          <p class="hero-price"><span>Planned for grades 3 to 8, up to 30 students.</span> <span><b>$200</b> for 50 minutes or <b>$300</b> for 90 minutes, per session. Monthly online plans from <b>$9.99</b>. Not booking yet.</span></p>
        </div>
        <div class="stage-hero" id="heroStage" role="img" aria-label="Rendered hand tools resting on a workbench: hammer, screwdrivers, wrench, tape measure and level">
          <div class="fallback" id="heroFallback" aria-hidden="true">
            <svg viewBox="0 0 600 420"><g transform="translate(40 40)"><use href="#t-hammer" width="120" height="320"/></g><g transform="translate(160 70) rotate(-8 40 120)"><use href="#t-phillips" width="90" height="260"/></g><g transform="translate(250 50)"><use href="#t-tape" width="120" height="300"/></g><g transform="translate(370 60) rotate(6 40 120)"><use href="#t-wrench" width="90" height="280"/></g><g transform="translate(470 30)"><use href="#t-level" width="100" height="340"/></g></svg>
          </div>
          <div class="float f1" aria-hidden="true"><b>Grades 3–8</b><span>Elementary &amp; middle school</span></div>
          <div class="float f2" aria-hidden="true"><b>Learn by doing</b><span>Every session is hands-on</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="doors-sec" aria-labelledby="path-h">
    <div class="wrap">
      <h2 class="sr-only" id="path-h">Where to start</h2>
      <div class="doors stg">
        <a class="door" href={base + 'workshops/'}><span class="door-art" style="background:var(--mist)"><svg viewBox="0 0 200 120" aria-hidden="true"><g transform="translate(46 8) rotate(-10 20 52)"><use href="#t-hammer" width="36" height="104"/></g><g transform="translate(84 10)"><use href="#t-phillips" width="32" height="100"/></g><g transform="translate(120 8) rotate(10 18 52)"><use href="#t-wrench" width="34" height="104"/></g></svg></span><span class="meta"><h3>In-person workshops</h3><p>Planned prices and how a class period runs.</p></span></a>
        <a class="door" href={base + 'monthly-plan/'}><span class="door-art" style="background:var(--butter)"><svg viewBox="0 0 200 120" aria-hidden="true"><rect x="62" y="14" width="76" height="92" rx="8" fill="#FCFBF8" stroke="#16211C" stroke-width="2.5"/><path d="M62 34h76" stroke="#16211C" stroke-width="2.5"/><path d="M80 8v14M120 8v14" stroke="#16211C" stroke-width="3" stroke-linecap="round"/><g fill="#16211C" opacity=".18"><rect x="72" y="44" width="12" height="12" rx="2"/><rect x="94" y="44" width="12" height="12" rx="2"/><rect x="116" y="44" width="12" height="12" rx="2"/><rect x="72" y="66" width="12" height="12" rx="2"/><rect x="116" y="66" width="12" height="12" rx="2"/><rect x="72" y="88" width="12" height="10" rx="2"/><rect x="94" y="88" width="12" height="10" rx="2"/></g><rect x="92" y="64" width="16" height="16" rx="3" fill="#2F6450"/><path d="M96 72l3 3 5-6" fill="none" stroke="#FCFBF8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="meta"><h3>Monthly plan</h3><p>Run our activities yourself, from $9.99 a month.</p></span></a>
        <a class="door" href={base + 'activities/'}><span class="door-art" style="background:var(--peach)"><svg viewBox="0 0 200 120" aria-hidden="true"><rect x="70" y="6" width="60" height="108" rx="12" fill="#16211C"/><rect x="75" y="16" width="50" height="88" rx="6" fill="#FCFBF8"/><rect x="80" y="26" width="32" height="14" rx="7" fill="#DDE7F0"/><rect x="88" y="46" width="32" height="14" rx="7" fill="#2F6450"/><rect x="80" y="66" width="26" height="14" rx="7" fill="#DDE7F0"/><path d="M84 92h32" stroke="#16211C" stroke-width="2" stroke-linecap="round" opacity=".25"/></svg></span><span class="meta"><h3>Try an activity</h3><p>Five short ones, free to play now.</p></span></a>
        <a class="door" href={base + 'manuals/'}><span class="door-art" style="background:var(--sage)"><svg viewBox="0 0 200 120" aria-hidden="true"><path d="M100 26c-14-10-34-12-52-8v80c18-4 38-2 52 8z" fill="#FCFBF8" stroke="#16211C" stroke-width="2.5" stroke-linejoin="round"/><path d="M100 26c14-10 34-12 52-8v80c-18-4-38-2-52 8z" fill="#FCFBF8" stroke="#16211C" stroke-width="2.5" stroke-linejoin="round"/><path d="M100 26v80" stroke="#16211C" stroke-width="2.5"/><g stroke="#16211C" stroke-width="2" stroke-linecap="round" opacity=".3"><path d="M60 40h28M60 52h28M60 64h22M112 40h28M112 52h28M112 64h22"/></g><path d="M112 76h20" stroke="#2F6450" stroke-width="3" stroke-linecap="round"/></svg></span><span class="meta"><h3>Free manuals</h3><p>Seven topics, ready to read and print.</p></span></a>
      </div>
    </div>
  </section>

  <section class="sec tight" aria-labelledby="prob-h">
    <div class="wrap problem reveal">
      <h2 class="big" id="prob-h">Young men are expected to fix things, stay safe online and handle money. <em>Many were never shown how.</em></h2>
      <p class="why">A video shows the steps, but it can’t tell you what you did wrong or when to stop. Parents working long hours can’t be there for every little lesson, and that’s not their fault. And boys are often told to tough it out, so they figure things out alone.</p>
      <a class="btn btn-line btn-sm" href={base + 'story/'}>Read why we started <svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </section>

  <section aria-labelledby="cur-h">
    <div class="wrap">
      <div class="panel sage reveal">
        <div class="sec-head">
          <h2 class="h-lg" id="cur-h">Eight topics for everyday life</h2>
          <p class="lede" style="color:#46504A">Schools pick the topics that fit their students. Every lesson includes a demo, hands-on practice, and when to ask for help.</p>
        </div>
        <div class="cx-tiles" id="cxTiles">
          {TOPICS.map((t, i) => (
            <button class="cx-tile" type="button" id={'cxt-' + t.k} aria-expanded="false" aria-controls="cxPanel" data-i={i}><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.ic} /></span><span class="nm">{t.t}</span>{t.later && <span class="st">Later</span>}<span class="pl" aria-hidden="true"></span></button>
          ))}
        </div>
        <div class="cx-panel" role="region" id="cxPanel" aria-labelledby="cxt-home" hidden><div class="cx-head"><div><h3>Home &amp; tools</h3><p>Using basic hand tools safely and handling the small fixes every home needs.</p></div><a class="btn btn-line btn-sm" href={base + 'manuals/home-tools.html'}>Read the free manual</a></div>
  <div class="cx-body"><div class="cx-lessons"><span class="label">Lessons</span><div class="lesson"><span class="n">1</span><b>Meet your toolbox</b><span class="ds">What each common hand tool is for, and how to hold it.</span></div><div class="lesson"><span class="n">2</span><b>Small fixes</b><span class="ds">Tighten a loose handle, hang something level, change a light bulb.</span></div><div class="lesson"><span class="n">3</span><b>When water goes wrong</b><span class="ds">Find the shutoff valve and what to do first during a leak.</span></div></div>
  <div class="cx-side"><div class="callout"><span class="label">Hands-on practice</span><p>A practice board with screws, nails, a level and a shutoff valve.</p></div><div class="callout stop"><span class="label">Know when to stop</span><p>Breakers, wiring, gas or anything sparking: step back and get an adult or a professional.</p></div></div></div></div>
      </div>
    </div>
  </section>

  <section class="sec tight" aria-labelledby="try-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-lg" id="try-h">Try an activity</h2>
        <p class="lede">Five short activities that give you a feel for what students do in a workshop.</p>
      </div>
      <div class="stg trow" id="actRow">
        <ActCard id="tools" />
        <ActCard id="budget" />
        <ActCard id="scams" />
        <ActCard id="call" />
        <ActCard id="laundry" />
      </div>
    </div>
  </section>

  <section class="sec tight" aria-labelledby="faq-h" id="faq">
    <div class="wrap faqwrap">
      <div><h2 class="h-lg" id="faq-h">Good to know</h2></div>
      <div class="stg faq">
        <details><summary>Are workshops running yet?</summary><div class="ans">Not yet. Own Two Feet is a student venture that’s still in development, so no workshops are running or booking. Join the interest list and we’ll email you when we launch.</div></details>
        <details><summary>Who are the workshops for?</summary><div class="ans">Boys and young men in elementary and middle school. Activities are matched to their age. Topics for older students, like car basics, come later.</div></details>
        <details><summary>What will it cost?</summary><div class="ans">We plan to charge $200 for a 50-minute workshop and $300 for a 90-minute one, per session, for up to 30 students. We bring the supplies. Or run our activities yourself with a <a href={base + 'monthly-plan/'}>monthly online plan</a>: $9.99 a month for a teacher or volunteer who shows proof, or $19.99 a month for a team of three. These are planned prices, and nothing is booking yet.</div></details>
        <details><summary>Will there be manuals?</summary><div class="ans">Yes. We’re writing a free manual for each topic that teachers, parents and students can use at home or in class. Seven are ready to read and print. Vehicle basics is on the way. <a href={base + 'manuals/'}>See the manuals</a>. The five activities on this site are free to try now.</div></details>
      </div>
    </div>
  </section>

  <section aria-labelledby="interest-h" id="interest">
    <div class="wrap">
      <div class="panel sage cta reveal">
        <div class="side">
          <h2 class="h-lg" id="interest-h">Bring Own Two Feet to your students</h2>
          <p>For adults: teachers, counselors, community leaders, parents and guardians.</p>
          <div class="note">
            <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>We’ll only email about our launch</div>
            <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>Your feedback shapes what we teach</div>
          </div>
        </div>
        <div id="formSlotHome"><InterestForm /></div>
      </div>
    </div>
  </section>
</div>
