---
import { base } from '../../base.js';
import { useT } from '../../i18n/t.js';
const { t, lang, home } = useT(Astro);
import ActCard from '../ActCard.astro';
import InterestForm from '../InterestForm.astro';
import JsText from '../JsText.astro';
// The eight topic tiles, each with small bare art (48x48). Their lessons live in src/i18n/*/home.json (mods.list) and open below the tiles on a tap. public/js/home.js reads the same text.
import ART from '../../data/topic-art.js';
const MODL = t('mods.list');
const M = MODL[0];
const TOPICS = [
  { k: 'home', t: MODL[0].t, art: ART.home },
  { k: 'tech', t: MODL[1].t, art: ART.tech },
  { k: 'care', t: MODL[2].t, art: ART.care },
  { k: 'cook', t: MODL[3].t, art: ART.cook },
  { k: 'money', t: MODL[4].t, art: ART.money },
  { k: 'comm', t: MODL[5].t, art: ART.comm },
  { k: 'help', t: MODL[6].t, art: ART.help },
  { k: 'car', t: MODL[7].t, later: true, art: ART.car }
];
---
<!-- ================= HOME ================= -->
<div class="view" data-view="home" id="home">

  <section class="hero">
    <div class="wrap">
      <div class="hero-card">
        <div class="hero-copy">
          <h1 class="h-xl" tabindex="-1" data-focus set:html={t('home.h1')}></h1>
          <p class="lede" style="color:#46504A">{t('home.lede')}</p>
          <div class="acts">
            <a class="btn btn-ink" href={home + '#interest'}>{t('home.join')}</a>
            <a class="btn btn-line" href={home + 'activities/'}>{t('home.explore')}</a>
          </div>
          <div class="hero-price">
            <ul>
              <li><b>$200</b><span>{t('home.p50')}</span></li>
              <li><b>$300</b><span>{t('home.p90')}</span></li>
              <li><b>$9.99</b><span>{t('home.pMonth')}</span></li>
            </ul>
            <p>{t('home.pNote')}</p>
          </div>
        </div>
        <div class="stage-hero" id="heroStage" role="img" aria-label={t('home.stage')}>
          <div class="fallback" id="heroFallback" aria-hidden="true">
            <svg viewBox="0 0 600 420"><g transform="translate(40 40)"><use href="#t-hammer" width="120" height="320"/></g><g transform="translate(160 70) rotate(-8 40 120)"><use href="#t-phillips" width="90" height="260"/></g><g transform="translate(250 50)"><use href="#t-tape" width="120" height="300"/></g><g transform="translate(370 60) rotate(6 40 120)"><use href="#t-wrench" width="90" height="280"/></g><g transform="translate(470 30)"><use href="#t-level" width="100" height="340"/></g></svg>
          </div>
          <div class="float f1" aria-hidden="true"><b>{t('home.f1b')}</b><span>{t('home.f1s')}</span></div>
          <div class="float f2" aria-hidden="true"><b>{t('home.f2b')}</b><span>{t('home.f2s')}</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="doors-sec" aria-labelledby="path-h">
    <div class="wrap">
      <h2 class="sr-only" id="path-h">{t('home.startH')}</h2>
      <div class="doors stg">
        <a class="door" href={home + 'workshops/'}><span class="door-art" style="background:var(--mist)"><svg viewBox="0 0 200 120" aria-hidden="true"><g transform="translate(46 8) rotate(-10 20 52)"><use href="#t-hammer" width="36" height="104"/></g><g transform="translate(84 10)"><use href="#t-phillips" width="32" height="100"/></g><g transform="translate(120 8) rotate(10 18 52)"><use href="#t-wrench" width="34" height="104"/></g></svg></span><span class="meta"><h3>{t('home.d1h')}</h3><p>{t('home.d1p')}</p></span></a>
        <a class="door" href={home + 'monthly-plan/'}><span class="door-art" style="background:var(--butter)"><svg viewBox="0 0 200 120" aria-hidden="true"><rect x="62" y="14" width="76" height="92" rx="8" fill="#FCFBF8" stroke="#16211C" stroke-width="2.5"/><path d="M62 34h76" stroke="#16211C" stroke-width="2.5"/><path d="M80 8v14M120 8v14" stroke="#16211C" stroke-width="3" stroke-linecap="round"/><g fill="#16211C" opacity=".18"><rect x="72" y="44" width="12" height="12" rx="2"/><rect x="94" y="44" width="12" height="12" rx="2"/><rect x="116" y="44" width="12" height="12" rx="2"/><rect x="72" y="66" width="12" height="12" rx="2"/><rect x="116" y="66" width="12" height="12" rx="2"/><rect x="72" y="88" width="12" height="10" rx="2"/><rect x="94" y="88" width="12" height="10" rx="2"/></g><rect x="92" y="64" width="16" height="16" rx="3" fill="#2F6450"/><path d="M96 72l3 3 5-6" fill="none" stroke="#FCFBF8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="meta"><h3>{t('home.d2h')}</h3><p>{t('home.d2p')}</p></span></a>
        <a class="door" href={home + 'activities/'}><span class="door-art" style="background:var(--peach)"><svg viewBox="0 0 200 120" aria-hidden="true"><rect x="70" y="6" width="60" height="108" rx="12" fill="#16211C"/><rect x="75" y="16" width="50" height="88" rx="6" fill="#FCFBF8"/><rect x="80" y="26" width="32" height="14" rx="7" fill="#DDE7F0"/><rect x="88" y="46" width="32" height="14" rx="7" fill="#2F6450"/><rect x="80" y="66" width="26" height="14" rx="7" fill="#DDE7F0"/><path d="M84 92h32" stroke="#16211C" stroke-width="2" stroke-linecap="round" opacity=".25"/></svg></span><span class="meta"><h3>{t('home.d3h')}</h3><p>{t('home.d3p')}</p></span></a>
        <a class="door" href={home + 'manuals/'}><span class="door-art" style="background:var(--sage)"><svg viewBox="0 0 200 120" aria-hidden="true"><path d="M100 26c-14-10-34-12-52-8v80c18-4 38-2 52 8z" fill="#FCFBF8" stroke="#16211C" stroke-width="2.5" stroke-linejoin="round"/><path d="M100 26c14-10 34-12 52-8v80c-18-4-38-2-52 8z" fill="#FCFBF8" stroke="#16211C" stroke-width="2.5" stroke-linejoin="round"/><path d="M100 26v80" stroke="#16211C" stroke-width="2.5"/><g stroke="#16211C" stroke-width="2" stroke-linecap="round" opacity=".3"><path d="M60 40h28M60 52h28M60 64h22M112 40h28M112 52h28M112 64h22"/></g><path d="M112 76h20" stroke="#2F6450" stroke-width="3" stroke-linecap="round"/></svg></span><span class="meta"><h3>{t('home.d4h')}</h3><p>{t('home.d4p')}</p></span></a>
      </div>
    </div>
  </section>

  <section class="sec tight" aria-labelledby="prob-h">
    <div class="wrap problem reveal">
      <h2 class="big" id="prob-h" set:html={t('home.probH')}></h2>
      <p class="why">{t('home.why')}</p>
      <a class="btn btn-line btn-sm" href={home + 'story/'}>{t('home.readWhy')} <svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </section>

  <section aria-labelledby="cur-h">
    <div class="wrap">
      <div class="panel sage reveal">
        <div class="sec-head">
          <h2 class="h-lg" id="cur-h">{t('home.curH')}</h2>
          <p class="lede" style="color:#46504A">{t('home.curLede')}</p>
        </div>
        <div class="cx">
        <div class="cx-tiles" id="cxTiles">
          {TOPICS.map((tp, i) => (
            <button class="cx-tile" type="button" id={'cxt-' + tp.k} aria-expanded="false" aria-controls="cxPanel" data-i={i}><span class="art"><svg viewBox="0 0 48 48" aria-hidden="true" set:html={tp.art} /></span><span class="nm">{tp.t}</span>{tp.later && <span class="st">{t('mods.ui.laterTile')}</span>}<span class="pl" aria-hidden="true"></span></button>
          ))}
        </div>
        <div class="cx-panel" role="region" id="cxPanel" aria-labelledby="cxt-home" hidden><div class="cx-head"><div><h3>{M.t}</h3><p>{M.d}</p></div><a class="btn btn-line btn-sm" href={home + 'manuals/home-tools.html'}>{t('mods.ui.man')}</a></div>
  <div class="cx-body"><div class="cx-lessons"><span class="label">{t('mods.ui.lessons')}</span>{M.L.map((l, j) => <div class="lesson"><span class="n">{j + 1}</span><b>{l[0]}</b><span class="ds">{l[1]}</span></div>)}</div>
  <div class="cx-side"><div class="callout"><span class="label">{t('mods.ui.hands')}</span><p>{M.st}</p></div><div class="callout stop"><span class="label">{t('mods.ui.stop')}</span><p>{M.stop}</p></div></div></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tight try" aria-labelledby="try-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="h-lg" id="try-h">{t('home.tryH')}</h2>
        <p class="lede">{t('home.tryLede')}</p>
      </div>
      <div class="stg trow" id="actRow">
        <ActCard id="tools" />
        <ActCard id="budget" />
        <ActCard id="scams" />
        <ActCard id="call" />
        <ActCard id="laundry" />
      </div>
    </div>
  </section>

  <section class="sec tight" aria-labelledby="faq-h" id="faq">
    <div class="wrap faqwrap">
      <div><h2 class="h-lg" id="faq-h">{t('home.faqH')}</h2></div>
      <div class="stg faq">
        <details><summary>{t('home.q1')}</summary><div class="ans">{t('home.a1')}</div></details>
        <details><summary>{t('home.q2')}</summary><div class="ans">{t('home.a2')}</div></details>
        <details><summary>{t('home.q3')}</summary><div class="ans">{t('home.a3a')}<a href={home + 'monthly-plan/'}>{t('home.a3link')}</a>{t('home.a3b')}</div></details>
        <details><summary>{t('home.q4')}</summary><div class="ans">{t('home.a4a')}<a href={home + 'manuals/'}>{t('home.a4link')}</a>{t('home.a4b')}</div></details>
      </div>
    </div>
  </section>

  <section aria-labelledby="interest-h" id="interest">
    <div class="wrap">
      <div class="panel sage cta reveal">
        <div class="side">
          <h2 class="h-lg" id="interest-h">{t('home.ctaH')}</h2>
          <p>{t('home.ctaP')}</p>
          <div class="note">
            <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>{t('home.n1')}</div>
            <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>{t('home.n2')}</div>
          </div>
        </div>
        <div id="formSlotHome"><InterestForm /></div>
      </div>
    </div>
  </section>
<JsText name="mods" />
</div>
