---
import { base } from '../../base.js';
import { useT } from '../../i18n/t.js';
const { t, lang, home } = useT(Astro);
import InterestForm from '../InterestForm.astro';
---
<!-- ================= GET INVOLVED ================= -->
<div class="view" data-view="involved" id="involved">
  <section class="phead"><div class="wrap"><div class="panel sage">
    <h1 class="h-xl" tabindex="-1" data-focus>{t('involved.h1')}</h1>
    <p class="lede" style="color:#46504A">{t('involved.lede')}</p>
  </div></div></section>
  <section class="sec tight"><div class="wrap">
    <h2 class="sr-only">{t('involved.ways')}</h2>
    <div class="stg paths">
      <div class="path"><h3>{t('involved.p1h')}</h3><p>{t('involved.p1p')}</p><button class="btn btn-ink btn-sm" type="button" data-pick="inperson">{t('involved.p1b')}</button></div>
      <div class="path"><h3>{t('involved.p2h')}</h3><p>{t('involved.p2p')}</p><button class="btn btn-ink btn-sm" type="button" data-pick="inperson">{t('involved.p2b')}</button></div>
      <div class="path"><h3>{t('involved.p3h')}</h3><p>{t('involved.p3p')}</p><button class="btn btn-ink btn-sm" type="button" data-pick="family">{t('involved.p3b')}</button></div>
      <div class="path"><span class="chip soon" style="justify-self:start">{t('involved.later')}</span><h3>{t('involved.p4h')}</h3><p>{t('involved.p4p')}</p><button class="btn btn-ink btn-sm" type="button" data-pick="mentor">{t('involved.p4b')}</button></div>
    </div>
  </div></section>
  <section><div class="wrap"><div class="panel white cta">
    <div class="side"><h2 class="h-lg">{t('involved.formH')}</h2><p>{t('involved.formP')}</p></div>
    <div id="formSlotInvolved"><InterestForm /></div>
  </div></div></section>
</div>
