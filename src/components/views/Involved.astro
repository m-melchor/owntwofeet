---
import { base } from '../../base.js';
import InterestForm from '../InterestForm.astro';
---
<!-- ================= GET INVOLVED ================= -->
<div class="view" data-view="involved" id="involved">
  <section class="phead"><div class="wrap"><div class="panel sage">
    <h1 class="h-xl" tabindex="-1" data-focus>Help bring workshops to more students</h1>
    <p class="lede" style="color:#46504A">We’re just getting started, and the people who join now help decide what we build.</p>
  </div></div></section>
  <section class="sec tight"><div class="wrap">
    <h2 class="sr-only">Ways to help</h2>
    <div class="stg paths">
      <div class="path"><h3>Schools &amp; counselors</h3><p>Tell us you’d want workshops for your students and which topics matter most. We’ll email you when we launch.</p><button class="btn btn-ink btn-sm" type="button" data-interest="workshops">I’d want this at my school</button></div>
      <div class="path"><h3>Community organizations</h3><p>Youth programs, churches, rec centers and nonprofits that serve boys and young men.</p><button class="btn btn-ink btn-sm" type="button" data-interest="workshops">Host in our community</button></div>
      <div class="path"><h3>Parents &amp; guardians</h3><p>Stay in the loop, suggest skills you’d like covered, and hear about family days.</p><button class="btn btn-ink btn-sm" type="button" data-interest="family">Keep me updated</button></div>
      <div class="path"><span class="chip soon" style="justify-self:start">Coming later</span><h3>Mentors &amp; volunteers</h3><p>Adults who are handy and care about kids. We’ll share details when we launch.</p><button class="btn btn-ink btn-sm" type="button" data-interest="mentor">I’d like to volunteer</button></div>
    </div>
  </div></section>
  <section><div class="wrap"><div class="panel white cta">
    <div class="side"><h2 class="h-lg">Tell us how you’d like to help</h2><p>Adults only, please. We’ll only use your info to send Own Two Feet updates.</p></div>
    <div id="formSlotInvolved"><InterestForm /></div>
  </div></div></section>
</div>

