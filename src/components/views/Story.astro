---
import { base } from '../../base.js';
import { useT } from '../../i18n/t.js';
import JsText from '../JsText.astro';
const { t, lang, home } = useT(Astro);
---
<!-- ================= STORY ================= -->
<div class="view" data-view="story" id="story">
  <section class="phead ctr"><div class="wrap"><div class="panel peach with-art">
    <svg class="phead-art" viewBox="0 0 320 300" aria-hidden="true"><defs><g id="stFoot"><circle cx="24" cy="7" r="6"/><circle cx="33" cy="11.5" r="4"/><circle cx="38.5" cy="18" r="3.3"/><circle cx="41" cy="25" r="2.8"/><path d="M21 2C33 3 38 15 37 30C36 43 31 51 30 61C29 71 32 79 30 89C28 98 13 98 11 89C9 79 13 71 11 61C9 50 3 41 4 28C5 13 10 1 21 2Z" transform="translate(1 18) scale(.86)"/></g></defs><use href="#stFoot" fill="#16211C" opacity=".3" transform="translate(150 0) rotate(5) scale(-.8 .8)"/><use href="#stFoot" fill="#2F6450" opacity=".5" transform="translate(178 52) rotate(8) scale(.8)"/><use href="#stFoot" fill="#16211C" opacity=".7" transform="translate(146 106) rotate(5) scale(-.8 .8)"/><use href="#stFoot" fill="#2F6450" opacity=".85" transform="translate(182 158) rotate(8) scale(.8)"/><use href="#stFoot" fill="#16211C" transform="translate(142 212) rotate(5) scale(-.8 .8)"/></svg>
    <h1 class="h-xl" tabindex="-1" data-focus>{t('story.h1')}</h1>
  </div></div></section>
  <section class="sec tight"><div class="wrap split">
    <div class="prose">
      <p>{t('story.p1')}</p>
      <p><Fragment set:html={t('story.p2')} /></p>
      <p>{t('story.p3')}</p>
    </div>
    <div class="panel sage" style="padding:clamp(26px,3vw,40px);display:grid;gap:14px"><h2 class="h-md">{t('story.stillH')}</h2><p class="muted">{t('story.stillP')}</p><div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:6px"><a class="btn btn-ink btn-sm" href={home + '#interest'}>{t('story.join')}</a><a class="btn btn-line btn-sm" href={home + 'manuals/'}>{t('story.manuals')}</a></div></div>
  </div></section>

  <section class="band" aria-labelledby="fou-h">
    <div class="wrap founders solo reveal">
      <div class="fq-wrap">
        <h2 class="sr-only" id="fou-h">{t('story.whyH')}</h2>
        <div class="fq-stack" id="vq" aria-live="off">
          <figure class="fq on"><blockquote class="big">{t('story.q1')}</blockquote><figcaption>{t('story.c1')}</figcaption></figure>
          <figure class="fq"><blockquote class="big">{t('story.q2')}</blockquote><figcaption>{t('story.c2')}</figcaption></figure>
          <figure class="fq"><blockquote class="big">{t('story.q3')}</blockquote><figcaption>{t('story.c3')}</figcaption></figure>
          <figure class="fq"><blockquote class="big">{t('story.q4')}</blockquote><figcaption>{t('story.c4')}</figcaption></figure>
          <figure class="fq"><blockquote class="big">{t('story.q5')}</blockquote><figcaption>{t('story.c5')}</figcaption></figure>
        </div>
        <div class="fq-ctrl">
          <button class="icon-btn" type="button" id="vqPrev" aria-label={t('story.prevQ')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
          <button class="icon-btn" type="button" id="vqNext" aria-label={t('story.nextQ')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
          <span class="count" id="vqCount">1 {t('story.of')} 5</span>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tight"><div class="wrap">
    <div class="sec-head"><h2 class="h-lg">{t('story.whoH')}</h2><p class="lede">{t('story.whoLede')}</p></div>
    <div class="team">
      <article class="member"><div class="photo"><span>{t('story.photo')}</span></div><h3>Marco Melchor</h3><p class="role">{t('story.m1role')}</p><p>{t('story.m1p')}</p></article>
      <article class="member"><div class="photo"><span>{t('story.photo')}</span></div><h3>Dane</h3><p class="role">{t('story.m2role')}</p><p>{t('story.m2p')}</p></article>
      <article class="member"><div class="photo"><span>{t('story.photo')}</span></div><h3>Jewell</h3><p class="role">{t('story.m3role')}</p><p>{t('story.m3p')}</p></article>
    </div>
  </div></section>
  <section><div class="wrap"><div class="panel sand">
    <div class="sec-head"><h2 class="h-lg">{t('story.shapedH')}</h2><p class="lede" style="color:#46504A">{t('story.shapedLede')}</p></div>
    <div class="stg values hscroll" id="ivRow">
      <div class="value"><h3>{t('story.v1h')}</h3><p>{t('story.v1p')}</p></div>
      <div class="value"><h3>{t('story.v2h')}</h3><p>{t('story.v2p')}</p></div>
      <div class="value"><h3>{t('story.v3h')}</h3><p>{t('story.v3p')}</p></div>
      <div class="value"><h3>{t('story.v4h')}</h3><p>{t('story.v4p')}</p></div>
    </div>
    <div class="rowctl"><button class="icon-btn" type="button" id="ivPrev" aria-label={t('story.prevIv')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button><button class="icon-btn" type="button" id="ivNext" aria-label={t('story.nextIv')}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button><span class="count" id="ivCount" aria-live="polite">1 {t('story.of')} 4</span></div>
  </div></div></section>
  <section class="sec tight"><div class="wrap">
    <div class="sec-head"><h2 class="h-lg">{t('story.commitH')}</h2></div>
    <div class="stg values commit" id="commits">
      <details class="value tint-1" open><summary><h3>{t('story.k1h')}</h3></summary><p>{t('story.k1p')}</p></details>
      <details class="value tint-2" open><summary><h3>{t('story.k2h')}</h3></summary><p>{t('story.k2p')}</p></details>
      <details class="value tint-3" open><summary><h3>{t('story.k3h')}</h3></summary><p>{t('story.k3p')}</p></details>
      <details class="value tint-4" open><summary><h3>{t('story.k4h')}</h3></summary><p>{t('story.k4p')}</p></details>
    </div>
  </div></section>
  <section><div class="wrap"><div class="panel sage" style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center"><div style="display:grid;gap:12px;max-width:560px"><h2 class="h-md">{t('story.ctaH')}</h2><p class="muted">{t('story.ctaP')}</p></div><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-ink" href={home + '#interest'}>{t('story.join')}</a><a class="btn btn-line" href={home + 'workshops/'}>{t('story.workshops')}</a></div></div></div></section>
<JsText name="storyjs" />
</div>

