---
import { base } from '../../base.js';
import { useT } from '../../i18n/t.js';
const { t, lang, home } = useT(Astro);
---
<!-- ================= WORKSHOPS ================= -->
<div class="view" data-view="workshops" id="workshops">
  <section class="phead ctr"><div class="wrap"><div class="panel mist with-art">
    <svg class="phead-art" viewBox="0 0 320 300" aria-hidden="true"><g transform="translate(36 20) rotate(-12 40 125)"><use href="#t-phillips" width="80" height="250"/></g><g transform="translate(116 6)"><use href="#t-tape" width="90" height="270"/></g><g transform="translate(210 22) rotate(12 40 125)"><use href="#t-flat" width="80" height="250"/></g></svg>
    <h1 class="h-xl" tabindex="-1" data-focus>{t('workshops.h1')}</h1>
    <p class="lede" style="color:#46504A">{t('workshops.lede')}</p>
  </div></div></section>

  <section class="sec tight"><div class="wrap">
    <div class="sec-head"><h2 class="h-lg">{t('workshops.priceH')}</h2><p class="lede">{t('workshops.priceLede')}</p></div>
    <div class="plans">
    <div class="pgroup" id="plan-live">
      <div class="pg-head"><h3>{t('workshops.inPersonH')}</h3><p>{t('workshops.inPersonP')}</p></div>
      <div class="pg-cards">
        <article class="plan"><h4>{t('workshops.w50')}</h4><p class="price">$200<small>{t('workshops.perSession')}</small></p><p>{t('workshops.w50p')}</p><a class="btn btn-line btn-sm" href={home + '#interest'} data-pick="inperson">{t('workshops.join')}</a></article>
        <article class="plan"><h4>{t('workshops.w90')}</h4><p class="price">$300<small>{t('workshops.perSession')}</small></p><p>{t('workshops.w90p')}</p><a class="btn btn-line btn-sm" href={home + '#interest'} data-pick="inperson">{t('workshops.join')}</a></article>
      </div>
      <p class="pg-foot"><Fragment set:html={t('workshops.series')} /></p>
    </div>
    <div class="pgroup" id="plan-monthly">
      <div class="pg-head"><h3>{t('workshops.monthlyH')}</h3><p>{t('workshops.monthlyP')}</p></div>
      <div class="pg-cards">
        <article class="plan"><h4>{t('workshops.teacherPlan')}</h4><p class="price">$9.99<small>{t('workshops.perMonth')}</small></p><p>{t('workshops.teacherP')}</p><a class="btn btn-line btn-sm" href={home + 'monthly-plan/#teacher'}>{t('workshops.seePlan')}</a></article>
        <article class="plan"><h4>{t('workshops.teamPlan')}</h4><p class="price">$19.99<small>{t('workshops.perMonth')}</small></p><p>{t('workshops.teamP')}</p><a class="btn btn-line btn-sm" href={home + 'monthly-plan/#team'}>{t('workshops.seePlan')}</a></article>
      </div>
      <p class="pg-foot"><Fragment set:html={t('workshops.first')} /></p>
    </div>
    </div>
  </div></section>

  <section class="sec tight" id="sesPin" aria-labelledby="ses-h"><div class="wrap">
    <div class="sec-head"><h2 class="h-lg" id="ses-h">{t('workshops.sesH')}</h2><p class="lede">{t('workshops.sesLede')}</p></div>
    <div class="ptime" aria-hidden="true"><i style="flex:5;background:var(--peach)"></i><i style="flex:10;background:var(--mist)"></i><i style="flex:25;background:var(--sage)"></i><i style="flex:10;background:var(--butter)"></i></div>
    <ol class="parts">
      <li class="part" style="--c:var(--peach)"><span class="label">{t('workshops.min5')}</span><h3>{t('workshops.open')}</h3><p><Fragment set:html={t('workshops.openP')} /></p></li>
      <li class="part" style="--c:var(--mist)"><span class="label">{t('workshops.min10')}</span><h3>{t('workshops.show')}</h3><p><Fragment set:html={t('workshops.showP')} /></p></li>
      <li class="part" style="--c:var(--sage)"><span class="label">{t('workshops.min25')}</span><h3>{t('workshops.practice')}</h3><p><Fragment set:html={t('workshops.practiceP')} /></p></li>
      <li class="part" style="--c:var(--butter)"><span class="label">{t('workshops.min10')}</span><h3>{t('workshops.debrief')}</h3><p><Fragment set:html={t('workshops.debriefP')} /></p></li>
    </ol>
  </div></section>

  <section><div class="wrap"><div class="panel sand">
    <div class="sec-head"><h2 class="h-lg">{t('workshops.ageH')}</h2><p class="lede" style="color:#46504A">{t('workshops.ageLede')}</p></div>
    <div class="agewrap">
      <div class="modes fit" role="tablist" aria-label={t('workshops.ageLabel')} id="ageTabs">
        <button class="mode" type="button" role="tab" id="agt-1" aria-controls="agp-1" aria-selected="true" tabindex="0">{t('workshops.tab1')}</button>
        <button class="mode" type="button" role="tab" id="agt-2" aria-controls="agp-2" aria-selected="false" tabindex="-1">{t('workshops.tab2')}</button>
        <button class="mode" type="button" role="tab" id="agt-3" aria-controls="agp-3" aria-selected="false" tabindex="-1">{t('workshops.tab3')}</button>
      </div>
      <div class="agep">
        <article class="tier on" role="tabpanel" id="agp-1" aria-labelledby="agt-1"><h3>{t('workshops.t1h')}</h3><p>{t('workshops.t1p')}</p><ul>{t('workshops.t1l').map((x) => <li>{x}</li>)}</ul></article>
        <article class="tier" role="tabpanel" id="agp-2" aria-labelledby="agt-2"><h3>{t('workshops.t2h')}</h3><p>{t('workshops.t2p')}</p><ul>{t('workshops.t2l').map((x) => <li>{x}</li>)}</ul></article>
        <article class="tier" role="tabpanel" id="agp-3" aria-labelledby="agt-3"><span class="chip soon" style="justify-self:start">{t('workshops.preview')}</span><h3>{t('workshops.t3h')}</h3><p>{t('workshops.t3p')}</p><ul>{t('workshops.t3l').map((x) => <li>{x}</li>)}</ul></article>
      </div>
    </div>
  </div></div></section>

  <section class="sec tight"><div class="wrap">
    <div class="sec-head"><h2 class="h-lg">{t('workshops.whoH')}</h2></div>
    <ol class="steps">
      <li class="step"><span class="sn" aria-hidden="true">1</span><div class="sb"><svg class="si" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10h18M6 10v9M18 10v9M9 15h6M7 10V6h10v4"/></svg><h3>{t('workshops.host')}</h3><p>{t('workshops.hostP')}</p></div></li>
      <li class="step"><span class="sn" aria-hidden="true">2</span><div class="sb"><svg class="si" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="9" width="18" height="11" rx="2"/><path d="M9 9V6.5A1.5 1.5 0 0 1 10.5 5h3A1.5 1.5 0 0 1 15 6.5V9M3 14h18M11 13v3h2v-3"/></svg><h3>{t('workshops.bring')}</h3><p>{t('workshops.bringP')}</p></div></li>
      <li class="step"><span class="sn" aria-hidden="true">3</span><div class="sb"><svg class="si" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-4 3-6.5 7-6.5s7 2.5 7 6.5"/></svg><h3>{t('workshops.lead')}</h3><p>{t('workshops.leadP')}</p></div></li>
    </ol>
  </div></section>

  <section><div class="wrap"><div class="panel sage" style="display:flex;flex-wrap:wrap;gap:24px;justify-content:space-between;align-items:center"><div style="display:grid;gap:12px;max-width:560px"><h2 class="h-md">{t('workshops.ctaH')}</h2><p class="muted">{t('workshops.ctaP')}</p></div><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-ink" href={home + '#interest'}>{t('workshops.join')}</a><a class="btn btn-line" href={home + 'activities/'}>{t('workshops.explore')}</a></div></div></div></section>
</div>

