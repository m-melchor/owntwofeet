---
// Plain pages outside the main site shell: each manual, the manuals list, privacy and 404.
// Each page imports its own CSS. Slots: art (drawings before the header), default (inside main),
// foot (inside the footer), head (extra head tags), end (scripts after the footer).
import Mark from '../components/Mark.astro';
import { base } from '../base.js';
import { useT, twinPath } from '../i18n/t.js';
const { t, lang, home } = useT(Astro);
// Language twins for search engines (not on noindex pages like 404).
const ORIGIN = 'https://m-melchor.github.io';
const here = Astro.url.pathname, twin = twinPath(here);
const enPath = lang === 'es' ? twin : here, esPath = lang === 'es' ? here : twin;
// Fonts are served from our own site. A face is only downloaded when a page uses it.
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/young-serif/400.css';
import '../styles/sprog.css';
// mono is no longer needed (each font file only loads when used); kept here so it doesn't land on <body>.
const { title, description, canonical, robots, mono, mark, small = false, back = home, mainId = 'top', ...bodyAttrs } = Astro.props;
---
<!doctype html><html lang={lang === 'es' ? 'es-MX' : 'en'}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<slot name="head" />
<title>{title}</title>
{robots && <meta name="robots" content={robots}>}
{description && <meta name="description" content={description}>}
<meta name="theme-color" content="#F6F4EF">
{canonical && <link rel="canonical" href={canonical}>}
{!robots && <><link rel="alternate" hreflang="en" href={ORIGIN + enPath}><link rel="alternate" hreflang="es" href={ORIGIN + esPath}><link rel="alternate" hreflang="x-default" href={ORIGIN + enPath}></>}
<link rel="icon" href={base + 'apple-touch-icon.png'}>
<link rel="apple-touch-icon" href={base + 'apple-touch-icon.png'}>
</head>
<body {...bodyAttrs}>
<slot name="art" />
<header class="site">
  <div class="wrap">
    <a class="brand" href={home}>
      <Mark id={mark} small={small} />
      <span>{t('site.name')}</span>
    </a>
    <a class="back" href={back}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>{t('site.backToSite')}</a>
  </div>
</header>

<main id={mainId || undefined}>
<slot />
</main>

<footer class="site-foot">
  <div class="wrap">
    <slot name="foot" />
  </div>
</footer>
<script is:inline src={base + 'js/sprog.js'}></script>
<slot name="end" />
</body></html>
