---
import Layout from '../../../layouts/Layout.astro';
import Tools from '../../../components/activities/Tools.astro';
import Budget from '../../../components/activities/Budget.astro';
import Scams from '../../../components/activities/Scams.astro';
import Call from '../../../components/activities/Call.astro';
import Laundry from '../../../components/activities/Laundry.astro';
import { base } from '../../../base.js';
import { ORDER, NAMES, CARDS } from '../../../data/activities.js';
export function getStaticPaths() {
  return ORDER.map((id, i) => ({ params: { id }, props: { nx: ORDER[i + 1] || null } }));
}
const { id } = Astro.params;
const { nx } = Astro.props;
const Game = { tools: Tools, budget: Budget, scams: Scams, call: Call, laundry: Laundry }[id];
const prev = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>';
const next = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>';
---
<Layout title={NAMES[id]} path={'activities/' + id + '/'} view="activities">
<div class="view" data-view="activities" id="activities">
  <section id="actScreens"><div class="wrap">
    <Game>
      <a slot="top" class="act-back" href={base + 'activities/'}><Fragment set:html={prev} />Back to activities</a>
      {nx
        ? <a slot="end" class="act-next" href={base + 'activities/' + nx + '/'}><Fragment set:html={CARDS[nx].art} /><span class="nx"><small>Next activity</small><b>{NAMES[nx]}</b></span><Fragment set:html={next} /></a>
        : <a slot="end" class="act-next end" href={base + 'activities/'}><span class="nx"><small>That was the last one</small><b>See all activities</b></span><Fragment set:html={next} /></a>}
    </Game>
  </div></section>
</div>
<Fragment slot="scripts">
{id === 'tools' && <script is:inline src={base + 'js/gl.js'}></script>}
<script is:inline src={base + 'js/' + id + '.js'}></script>
</Fragment>
</Layout>
