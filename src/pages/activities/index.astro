---
import Layout from '../../layouts/Layout.astro';
import Activities from '../../components/views/Activities.astro';
import { base } from '../../base.js';
import { useT } from '../../i18n/t.js';
const { t } = useT(Astro);
---
<Layout title={t('nav.activities')} path="activities/" view="activities">
<Activities />
<script slot="scripts" is:inline src={base + 'js/activities.js'}></script>
</Layout>
