---
import Sub from '../layouts/Sub.astro';
import '../styles/privacy.css';
import { getEntry } from 'astro:content';
import { base } from '../base.js';
import { useT } from '../i18n/t.js';
const { t, lang, home } = useT(Astro);

const page = await getEntry('pages', lang + '/privacy') ?? await getEntry('pages', 'en/privacy');
---
<Sub title={page.data.title} description={page.data.description} canonical={Astro.site + base.slice(1) + (lang === 'es' ? 'es/' : '') + 'privacy.html'} mark="pv" small>
<Fragment set:html={page.body} />
<Fragment slot="foot">
    <span>{t('site.copy')}</span>
    <a href={home} style="text-decoration:none">{t('site.backToSite')}</a>
</Fragment>
</Sub>
